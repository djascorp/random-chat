# ---------------------------------------------------------------------------
# RandomChat — environment reference. Copy to .env and adjust.
# Every variable is optional; the defaults make `go run ./cmd/api` work.
# ---------------------------------------------------------------------------

# --- HTTP ---------------------------------------------------------------
ADDR=:8080
LOG_LEVEL=info

# Comma separated list of browser origins allowed to open the WebSocket.
# Same-origin is always accepted, so a deployment that serves the SPA from this
# very server (the default) works with no entry here. List only *other* origins,
# such as the Vite dev server. In production, never use "*".
ALLOWED_ORIGINS=http://localhost:5173

# Directory holding the built SPA. The server returns a helpful message when it
# is missing, which is what you see before running `npm run build`.
WEB_DIR=web/dist

# --- Storage ------------------------------------------------------------
# Leave empty to use the in-memory store (no persistence, single instance).
DATABASE_URL=postgres://randomchat:randomchat@localhost:5432/randomchat?sslmode=disable
AUTO_MIGRATE=true
MIGRATIONS_DIR=migrations

# --- Media --------------------------------------------------------------
# JSON array matching the browser RTCIceServer dictionary.
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
#
# Or use the TURN shortcuts, which are appended to the list:
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_USERNAME=randomchat
TURN_CREDENTIAL=CHANGE_ME

# --- Matching and protocol ---------------------------------------------
QUEUE_TIMEOUT=90s
MAX_MESSAGE_BYTES=65536
MAX_CHAT_RUNES=1000
SEND_BUFFER=256
PING_INTERVAL=25s
PONG_TIMEOUT=60s
WRITE_TIMEOUT=10s
SHUTDOWN_GRACE=15s

# --- Abuse protection ---------------------------------------------------
JOIN_RATE_PER_MIN=40
CHAT_RATE_PER_MIN=120
REPORT_RATE_PER_MIN=10
SIGNAL_RATE_PER_MIN=600
AUTO_SUSPEND_AFTER=3
SUSPEND_DURATION=30m
VIOLATION_LIMIT=5

# --- Moderation API -----------------------------------------------------
# When empty, /api/admin/* responds 404 and the admin surface does not exist.
ADMIN_TOKEN=
